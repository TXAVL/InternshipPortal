@model DashboardViewModel

@{
    ViewData["Title"] = "Tổng quan thực tập";
    var culture = System.Globalization.CultureInfo.InvariantCulture;
    var statuses = new (ApplicationStatus Status, string Label)[]
    {
        (ApplicationStatus.Pending, "Chờ duyệt"),
        (ApplicationStatus.Interview, "Mời phỏng vấn"),
        (ApplicationStatus.Accepted, "Trúng tuyển"),
        (ApplicationStatus.Rejected, "Từ chối")
    };
}

<h1 class="h3 fw-bold mb-3">Tổng quan thực tập</h1>

<partial name="_Alerts" />

<div class="mb-4 d-flex flex-wrap gap-2 align-items-center">
    <a asp-controller="Company" asp-action="Index" class="btn btn-outline-primary">Duyệt doanh nghiệp</a>
    <a asp-controller="Application" asp-action="ExportExcel" class="btn btn-success">Xuất Excel hồ sơ</a>
    <form asp-action="ResetDemoData" method="post" class="ms-auto"
          onsubmit="return confirm('Toàn bộ dữ liệu hiện tại sẽ bị xóa và thay bằng dữ liệu mẫu ban đầu. Bạn chắc chắn muốn tiếp tục?');">
        <button type="submit" class="btn btn-outline-danger">
            <i class="bi bi-arrow-counterclockwise me-1"></i>Khôi phục dữ liệu mẫu
        </button>
    </form>
</div>

<div class="row g-3 mb-4">
    @{
        var cards = new (string Icon, string Color, string Bg, string Value, string Label, string Sub)[]
        {
            ("bi-building", "#1d4ed8", "#dbeafe", Model.TotalCompanies.ToString(), "Doanh nghiệp", $"đã duyệt: {Model.ApprovedCompanies}"),
            ("bi-briefcase", "#7c3aed", "#ede9fe", Model.TotalJobPosts.ToString(), "Tin tuyển dụng", $"đang mở: {Model.ActiveJobPosts}"),
            ("bi-file-earmark-person", "#d97706", "#fef3c7", Model.TotalApplications.ToString(), "Hồ sơ ứng tuyển", $"từ {Model.TotalStudentsApplied} sinh viên"),
            ("bi-patch-check", "#059669", "#d1fae5", Model.PlacementRate.ToString("0.#", culture) + "%", "Tỷ lệ có nơi thực tập", $"{Model.AcceptedStudents} SV trúng tuyển")
        };
    }
    @foreach (var c in cards)
    {
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <span class="stat-icon mb-2" style="background:@c.Bg;color:@c.Color"><i class="bi @c.Icon"></i></span>
                <div class="stat-value">@c.Value</div>
                <div class="stat-label">@c.Label</div>
                <div class="small text-secondary">@c.Sub</div>
            </div>
        </div>
    }
</div>

<h2 class="h5 fw-bold">Hồ sơ theo trạng thái</h2>
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        @{
            var colors = new Dictionary<ApplicationStatus, string>
            {
                [ApplicationStatus.Pending] = "#f59e0b",
                [ApplicationStatus.Interview] = "#3b82f6",
                [ApplicationStatus.Accepted] = "#10b981",
                [ApplicationStatus.Rejected] = "#ef4444"
            };
        }
        @foreach (var s in statuses)
        {
            var pct = Model.PercentOf(s.Status).ToString("0", culture);
            <div class="mb-3">
                <div class="d-flex justify-content-between small mb-1">
                    <span class="fw-semibold">@s.Label</span>
                    <span class="text-secondary">@Model.CountOf(s.Status) hồ sơ · @pct%</span>
                </div>
                <div class="bar-track" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100" aria-label="@s.Label">
                    <div class="bar-fill" style="width:@pct%;background:@colors[s.Status]"></div>
                </div>
            </div>
        }
    </div>
</div>

<h2 class="h5 fw-bold">Hồ sơ theo doanh nghiệp</h2>
<table class="table table-bordered bg-white mb-4">
    <thead><tr><th>Doanh nghiệp</th><th>Tin tuyển dụng</th><th>Hồ sơ</th><th>Trúng tuyển</th></tr></thead>
    <tbody>
        @foreach (var c in Model.CompanyStats)
        {
            <tr>
                <td>
                    <a asp-controller="Company" asp-action="Detail" asp-route-id="@c.CompanyId">@c.CompanyName</a>
                    @if (!c.IsApproved) { <text>(chưa duyệt)</text> }
                </td>
                <td>@c.JobPosts</td>
                <td>@c.Applications</td>
                <td>@c.Accepted</td>
            </tr>
        }
    </tbody>
</table>

<h2 class="h5 fw-bold">Nhật ký thực tập mới nộp (@Model.ReportsAwaitingFeedback chờ nhận xét)</h2>
@if (!Model.RecentReports.Any())
{
    <p class="text-secondary">Chưa có sinh viên nào nộp nhật ký thực tập.</p>
}
else
{
    <table class="table table-bordered bg-white">
        <thead><tr><th>Sinh viên</th><th>Vị trí</th><th>Tuần</th><th>Ngày nộp</th><th>Nhận xét</th><th></th></tr></thead>
        <tbody>
            @foreach (var r in Model.RecentReports)
            {
                <tr>
                    <td>@r.Application.StudentProfile.FullName (@r.Application.StudentProfile.StudentCode)</td>
                    <td>@r.Application.JobPost.Title – @r.Application.JobPost.Company?.CompanyName</td>
                    <td>@r.WeekNumber</td>
                    <td>@r.SubmittedAt.ToString("dd/MM/yyyy")</td>
                    <td>@(string.IsNullOrWhiteSpace(r.MentorFeedback) && string.IsNullOrWhiteSpace(r.CompanyFeedback) ? "Chờ nhận xét" : "Đã nhận xét")</td>
                    <td><a asp-controller="Report" asp-action="Index" asp-fragment="report-@r.Id">Mở</a></td>
                </tr>
            }
        </tbody>
    </table>
}
