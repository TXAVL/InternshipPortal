@model IEnumerable<InternshipPortal.Web.Models.Application>

@{
    ViewData["Title"] = "Quản lý hồ sơ ứng tuyển";
    var jobPosts = ViewBag.JobPosts as List<InternshipPortal.Web.Models.JobPost> ?? new();
    int? selectedJobPostId = ViewBag.SelectedJobPostId;
    InternshipPortal.Web.Models.ApplicationStatus? selectedStatus = ViewBag.SelectedStatus;
    string? searchTerm = ViewBag.SearchTerm;
}

<div class="container-fluid py-4 px-md-4">
    <!-- Header Page -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="h3 fw-bold text-primary mb-1">Quản Lý Hồ Sơ Ứng Tuyển Thực Tập</h2>
            <p class="text-muted mb-0">Theo dõi, xét duyệt hồ sơ sinh viên và xuất báo cáo danh sách ứng tuyển.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportExcel" asp-route-jobPostId="@selectedJobPostId" asp-route-status="@selectedStatus" class="btn btn-success fw-semibold shadow-sm d-flex align-items-center gap-2">
                <span>📊</span> Xuất Báo Cáo Excel (.xlsx)
            </a>
            <a asp-controller="Job" asp-action="Index" class="btn btn-outline-primary d-flex align-items-center gap-1">
                <span>💼</span> Xem trang việc làm
            </a>
        </div>
    </div>

    <!-- Alert thông báo -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <strong>✓ Thành công:</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Thanh lọc và tìm kiếm -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 text-muted">🔍</span>
                        <input type="text" name="search" class="form-control border-start-0" placeholder="Tên sinh viên, MSSV, vị trí, công ty..." value="@searchTerm" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="jobPostId" class="form-select">
                        <option value="">-- Tất cả vị trí tuyển dụng --</option>
                        @foreach (var j in jobPosts)
                        {
                            if (selectedJobPostId == j.Id)
                            {
                                <option value="@j.Id" selected="selected">@j.Title</option>
                            }
                            else
                            {
                                <option value="@j.Id">@j.Title</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select">
                        <option value="">-- Tất cả trạng thái --</option>
                        @foreach (InternshipPortal.Web.Models.ApplicationStatus st in Enum.GetValues(typeof(InternshipPortal.Web.Models.ApplicationStatus)))
                        {
                            if (selectedStatus == st)
                            {
                                <option value="@st" selected="selected">@st</option>
                            }
                            else
                            {
                                <option value="@st">@st</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">Lọc dữ liệu</button>
                    @if (selectedJobPostId != null || selectedStatus != null || !string.IsNullOrEmpty(searchTerm))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại bộ lọc">Xóa</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách ứng tuyển -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-dark">
                Danh Sách Ứng Viên (@Model.Count() hồ sơ)
            </h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th style="width: 50px;" class="text-center">STT</th>
                        <th>Sinh viên</th>
                        <th>Thông tin liên hệ</th>
                        <th>Vị trí ứng tuyển</th>
                        <th>Doanh nghiệp</th>
                        <th class="text-center">Ngày nộp</th>
                        <th class="text-center">Hồ sơ CV</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center" style="width: 150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <div class="fs-1 mb-2">📋</div>
                                <div>Chưa có hồ sơ ứng tuyển nào phù hợp với điều kiện tìm kiếm.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        int stt = 1;
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center fw-bold text-muted">@(stt++)</td>
                                <td>
                                    <div class="fw-bold text-dark">@(item.StudentProfile?.FullName)</div>
                                    <div class="small text-muted">MSSV: <span class="badge bg-light text-dark border">@(item.StudentProfile?.StudentCode)</span></div>
                                    @if (!string.IsNullOrEmpty(item.StudentProfile?.Major))
                                    {
                                        <div class="small text-secondary">Ngành: @item.StudentProfile.Major</div>
                                    }
                                </td>
                                <td>
                                    <div class="small">📧 <a href="mailto:@item.StudentProfile?.Email" class="text-decoration-none">@item.StudentProfile?.Email</a></div>
                                    <div class="small text-muted">📱 @item.StudentProfile?.PhoneNumber</div>
                                </td>
                                <td>
                                    <a asp-controller="Job" asp-action="Detail" asp-route-id="@item.JobPostId" class="fw-semibold text-primary text-decoration-none">
                                        @(item.JobPost?.Title)
                                    </a>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        🏢 @(item.JobPost?.Company?.CompanyName)
                                    </span>
                                </td>
                                <td class="text-center small text-muted">
                                    @item.AppliedAt.ToString("dd/MM/yyyy")<br />
                                    <span class="text-secondary">@item.AppliedAt.ToString("HH:mm")</span>
                                </td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(item.StudentProfile?.CVPath))
                                    {
                                        <a href="@item.StudentProfile.CVPath" target="_blank" class="btn btn-sm btn-outline-info">
                                            📄 Tải CV
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Chưa có</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @switch (item.Status)
                                    {
                                        case InternshipPortal.Web.Models.ApplicationStatus.Pending:
                                            <span class="badge bg-warning text-dark px-3 py-2">⏳ Chờ duyệt</span>
                                            break;
                                        case InternshipPortal.Web.Models.ApplicationStatus.Interview:
                                            <span class="badge bg-info text-white px-3 py-2">📅 Mời phỏng vấn</span>
                                            break;
                                        case InternshipPortal.Web.Models.ApplicationStatus.Accepted:
                                            <span class="badge bg-success px-3 py-2">🎉 Trúng tuyển</span>
                                            break;
                                        case InternshipPortal.Web.Models.ApplicationStatus.Rejected:
                                            <span class="badge bg-danger px-3 py-2">❌ Từ chối</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            Đổi trạng thái
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow">
                                            @foreach (InternshipPortal.Web.Models.ApplicationStatus newStatus in Enum.GetValues(typeof(InternshipPortal.Web.Models.ApplicationStatus)))
                                            {
                                                if (newStatus != item.Status)
                                                {
                                                    <li>
                                                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                            <input type="hidden" name="id" value="@item.Id" />
                                                            <input type="hidden" name="status" value="@newStatus" />
                                                            <button type="submit" class="dropdown-item">
                                                                Chuyển sang: <strong>@newStatus</strong>
                                                            </button>
                                                        </form>
                                                    </li>
                                                }
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
