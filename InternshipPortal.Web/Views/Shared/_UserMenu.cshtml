@* Menu tài khoản: đọc từ Cookie Claims. Bạn A trau chuốt giao diện phần này. *@
@if (User.Identity?.IsAuthenticated == true)
{
    var roleName = User.IsInRole(Roles.Admin) ? "Khoa / Admin"
        : User.IsInRole(Roles.Company) ? "Doanh nghiệp"
        : User.IsInRole(Roles.Student) ? "Sinh viên" : "";

    <div class="d-flex align-items-center gap-2 text-white">
        <span class="small">
            <strong>@User.Identity.Name</strong>
            <span class="opacity-75">(@roleName)</span>
        </span>
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            <button type="submit" class="btn btn-light btn-sm text-primary fw-semibold">
                <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
            </button>
        </form>
    </div>
}
else
{
    <a asp-controller="Account" asp-action="Login" class="btn btn-light btn-sm px-3 text-primary fw-semibold">
        <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
    </a>
    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-sm px-3">Đăng ký</a>
}
