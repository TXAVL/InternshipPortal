<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cổng Thực Tập Doanh Nghiệp</title>

    <!-- Google Font & Bootstrap Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- CSS Framework & Custom Style -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InternshipPortal.Web.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light-subtle">
    <!-- Navbar Header -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-xs py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-primary fs-4" asp-controller="Job" asp-action="Index">
                    <span class="brand-icon d-flex align-items-center justify-content-center bg-primary text-white rounded-3">
                        <i class="bi bi-mortarboard-fill"></i>
                    </span>
                    <span>Internship<span class="text-dark">Portal</span></span>
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 rounded-2 fw-medium text-secondary hover-nav" asp-controller="Job" asp-action="Index">
                                <i class="bi bi-briefcase me-1 text-primary"></i> Việc làm thực tập
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 rounded-2 fw-medium text-secondary hover-nav" asp-controller="Company" asp-action="Index">
                                <i class="bi bi-building me-1 text-primary"></i> Doanh nghiệp
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 rounded-2 fw-medium text-secondary hover-nav" asp-controller="Application" asp-action="Index">
                                <i class="bi bi-file-earmark-check me-1 text-primary"></i> Quản lý ứng tuyển
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Job" asp-action="Create" class="btn btn-primary btn-sm px-3 py-2 fw-semibold shadow-sm d-flex align-items-center gap-1 rounded-pill">
                            <i class="bi bi-plus-lg"></i>
                            <span>Đăng tin</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Body Container -->
    <div class="flex-grow-1">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <!-- Professional Footer -->
    <footer class="bg-white border-top text-secondary pt-5 pb-4 mt-auto">
        <div class="container">
            <div class="row g-4 justify-content-between">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="brand-icon small d-flex align-items-center justify-content-center bg-primary text-white rounded-2">
                            <i class="bi bi-mortarboard-fill"></i>
                        </span>
                        <h5 class="fw-bold text-dark mb-0">InternshipPortal</h5>
                    </div>
                    <p class="small text-muted mb-3">
                        Nền tảng kết nối cơ hội thực tập chuyên nghiệp giữa sinh viên và các doanh nghiệp công nghệ, kinh tế hàng đầu.
                    </p>
                    <div class="d-flex gap-3 fs-5 text-muted">
                        <a href="#" class="text-secondary hover-primary"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-secondary hover-primary"><i class="bi bi-linkedin"></i></a>
                        <a href="#" class="text-secondary hover-primary"><i class="bi bi-github"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="fw-bold text-dark mb-3">Dành cho sinh viên</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
                        <li><a asp-controller="Job" asp-action="Index" class="text-decoration-none text-muted hover-primary">Tìm việc thực tập</a></li>
                        <li><a asp-controller="Company" asp-action="Index" class="text-decoration-none text-muted hover-primary">Danh sách doanh nghiệp</a></li>
                        <li><a asp-controller="Application" asp-action="Index" class="text-decoration-none text-muted hover-primary">Trạng thái hồ sơ</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="fw-bold text-dark mb-3">Nhà tuyển dụng</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
                        <li><a asp-controller="Job" asp-action="Create" class="text-decoration-none text-muted hover-primary">Đăng tin thực tập</a></li>
                        <li><a asp-controller="Application" asp-action="Index" class="text-decoration-none text-muted hover-primary">Xét duyệt ứng viên</a></li>
                        <li><a href="#" class="text-decoration-none text-muted hover-primary">Quy chế hợp tác</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-dark mb-3">Hỗ trợ kỹ thuật</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 text-muted mb-0">
                        <li><i class="bi bi-geo-alt me-2 text-primary"></i>Việt Nam</li>
                        <li><i class="bi bi-envelope me-2 text-primary"></i>support@internshipportal.vn</li>
                        <li><i class="bi bi-shield-check me-2 text-primary"></i>Bảo mật dữ liệu thực tập</li>
                    </ul>
                </div>
            </div>

            <hr class="my-4 text-muted opacity-25" />

            <div class="d-flex flex-wrap justify-content-between align-items-center small text-muted">
                <div>&copy; 2026 InternshipPortal. Tất cả quyền được bảo lưu.</div>
                <div>
                    <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted hover-primary me-3">Chính sách bảo mật</a>
                    <a href="#" class="text-decoration-none text-muted hover-primary">Điều khoản sử dụng</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>