@model ErrorViewModel
@{
    ViewData["Title"] = "Có lỗi xảy ra";
}

<div class="denied-wrap text-center">
    <div class="denied-icon"><i class="bi bi-bug"></i></div>
    <h1 class="h4 fw-bold mt-3">Có lỗi xảy ra</h1>
    <p class="text-secondary">Hệ thống gặp sự cố khi xử lý yêu cầu của bạn. Vui lòng thử lại; nếu lỗi lặp lại hãy báo cho quản trị viên.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-secondary">Mã yêu cầu: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4"><i class="bi bi-house me-1"></i>Về trang chủ</a>
</div>
