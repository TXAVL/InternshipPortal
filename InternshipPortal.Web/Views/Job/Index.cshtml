@model InternshipPortal.Web.Models.ViewModels.JobFilterViewModel

@{
    ViewData["Title"] = "Danh sách tin tuyển dụng";
}

<!-- Thanh tìm kiếm & lọc nhanh -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3 p-md-4">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="keyword" value="@Model?.Keyword" class="form-control border-start-0 ps-0" placeholder="Nhập từ khóa việc làm...">
                </div>
            </div>
            <div class="col-12 col-md-4">
                <select name="major" class="form-select">
                    <option value="">Tất cả</option>
                    @if (Model?.AvailableMajors != null && Model.AvailableMajors.Any())
                    {
                        foreach (var m in Model.AvailableMajors)
                        {
                            <option value="@m" selected="@(Model.Major == m)">@m</option>
                        }
                    }
                    else
                    {
                        <option value="CNTT" selected="@(Model?.Major == "CNTT")">CNTT</option>
                        <option value="Kinh Tế" selected="@(Model?.Major == "Kinh Tế")">Kinh Tế</option>
                        <option value="Điện Tử" selected="@(Model?.Major == "Điện Tử")">Điện Tử</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i> Tìm kiếm
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Lưới danh sách việc làm -->
<div class="row g-3">
    @if (Model?.Jobs != null && Model.Jobs.Any())
    {
        @foreach (var item in Model.Jobs)
        {
            <div class="col-12 col-md-6 col-lg-4 mb-3">
                <div class="card shadow-sm h-100 border-0 rounded-3">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <span class="badge bg-primary">@item.Major</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                @(string.IsNullOrEmpty(item.SalaryRange) ? "Thỏa thuận" : item.SalaryRange)
                            </span>
                        </div>

                        <h5 class="card-title fw-bold text-dark text-truncate mb-2" title="@item.Title">
                            @item.Title
                        </h5>

                        <div class="text-secondary small mb-3">
                            <div class="mb-1 text-truncate">
                                <i class="bi bi-building me-1 text-primary"></i> @(item.Company?.CompanyName ?? "Doanh nghiệp đối tác")
                            </div>
                            <div class="mb-1 text-truncate">
                                <i class="bi bi-geo-alt-fill me-1 text-danger"></i> @item.Location
                            </div>
                            <div class="text-muted">
                                <i class="bi bi-clock me-1"></i> Hạn: @item.ExpireDate.ToString("dd/MM/yyyy")
                            </div>
                        </div>

                        <div class="mt-auto pt-2 border-top">
                            <a href="@Url.Action("Detail", "Job", new { id = item.Id })" class="btn btn-outline-primary btn-sm w-100 fw-semibold">
                                Xem chi tiết <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <i class="bi bi-inbox fs-1 text-muted"></i>
            <p class="text-muted mt-2">Hiện chưa có tin tuyển dụng nào phù hợp.</p>
        </div>
    }
</div>