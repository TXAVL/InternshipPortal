@model IEnumerable<InternshipPortal.Web.Models.JobPost>

@{
    ViewData["Title"] = "Danh sách việc làm thực tập";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-primary mb-1">Cơ Hội Thực Tập Doanh Nghiệp</h1>
            <p class="text-muted mb-0">Khám phá các vị trí thực tập hấp dẫn và kết nối trực tiếp với doanh nghiệp hàng đầu.</p>
        </div>
        <div>
            <span class="badge bg-primary fs-6 px-3 py-2">@Model.Count() việc làm đang tuyển</span>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var job in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 border-top border-primary border-3">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-light text-primary border">@job.Major</span>
                            <span class="badge bg-success-subtle text-success">@job.SalaryRange</span>
                        </div>
                        <h5 class="card-title fw-bold mb-1">
                            <a asp-action="Detail" asp-route-id="@job.Id" class="text-decoration-none text-dark">
                                @job.Title
                            </a>
                        </h5>
                        <h6 class="card-subtitle text-muted mb-3">
                            <i class="bi bi-building"></i> @(job.Company?.CompanyName ?? "Doanh nghiệp")
                        </h6>

                        <p class="card-text text-secondary small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                            @job.Description
                        </p>

                        <div class="border-top pt-3 mt-2 small text-muted">
                            <div class="d-flex justify-content-between mb-1">
                                <span><i class="bi bi-geo-alt"></i> @job.Location</span>
                                <span><i class="bi bi-people"></i> Số lượng: <strong>@job.Quantity</strong></span>
                            </div>
                            <div class="text-end text-danger small">
                                Hạn nộp: @job.ExpireDate.ToString("dd/MM/yyyy")
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pt-0 pb-3">
                        <a asp-action="Detail" asp-route-id="@job.Id" class="btn btn-outline-primary w-100 btn-sm">
                            Xem chi tiết
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

