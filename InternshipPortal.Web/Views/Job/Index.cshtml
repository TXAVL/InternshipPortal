@model InternshipPortal.Web.Models.ViewModels.JobFilterViewModel

@{
    ViewData["Title"] = "Danh sách tin tuyển dụng";
    var hasFilter = !string.IsNullOrEmpty(Model.Keyword) || !string.IsNullOrEmpty(Model.Major) || !string.IsNullOrEmpty(Model.Location);
}

<!-- Thanh tìm kiếm & lọc nhanh -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3 p-md-4">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="keyword" value="@Model.Keyword" class="form-control border-start-0 ps-0" placeholder="Nhập từ khóa việc làm...">
                </div>
            </div>
            <div class="col-12 col-md-3">
                <select name="major" class="form-select" aria-label="Ngành nghề">
                    <option value="">Tất cả ngành nghề</option>
                    @foreach (var m in Model.AvailableMajors)
                    {
                        <option value="@m" selected="@(Model.Major == m)">@m</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <select name="location" class="form-select" aria-label="Địa điểm">
                    <option value="">Tất cả địa điểm</option>
                    @foreach (var loc in Model.AvailableLocations)
                    {
                        <option value="@loc" selected="@(Model.Location == loc)">@loc</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i> Tìm kiếm
                </button>
                @if (hasFilter)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại bộ lọc">Xóa</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Tiêu đề kết quả -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h4 class="fw-bold mb-0 text-dark">
        Vị trí đang mở
        <span class="badge bg-secondary-subtle text-secondary fs-6 ms-2">@Model.Jobs.Count() việc làm</span>
    </h4>
    <a asp-action="Create" class="btn btn-primary fw-semibold shadow-sm">
        <i class="bi bi-plus-lg me-1"></i>Đăng tin tuyển dụng
    </a>
</div>

<!-- Lưới danh sách việc làm -->
<div class="row g-3">
    @if (Model.Jobs.Any())
    {
        @foreach (var item in Model.Jobs)
        {
            <div class="col-12 col-md-6 col-lg-4 mb-3">
                <div class="card shadow-sm h-100 border-0 rounded-3">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <span class="badge bg-primary">@item.Major</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                @(string.IsNullOrEmpty(item.SalaryRange) ? "Thỏa thuận" : item.SalaryRange)
                            </span>
                        </div>

                        <h5 class="card-title fw-bold text-truncate mb-2" title="@item.Title">
                            <a asp-action="Detail" asp-route-id="@item.Id" class="text-decoration-none text-dark hover-primary">@item.Title</a>
                        </h5>

                        <div class="text-secondary small mb-3">
                            <div class="mb-1 text-truncate">
                                <i class="bi bi-building me-1 text-primary"></i> @(item.Company?.CompanyName ?? "Doanh nghiệp đối tác")
                            </div>
                            <div class="mb-1 text-truncate">
                                <i class="bi bi-geo-alt-fill me-1 text-danger"></i> @item.Location
                            </div>
                            <div class="mb-1">
                                <i class="bi bi-people me-1 text-info"></i> Chỉ tiêu: @item.Quantity
                            </div>
                            <div class="text-muted">
                                <i class="bi bi-clock me-1"></i> Hạn: @item.ExpireDate.ToString("dd/MM/yyyy")
                            </div>
                        </div>

                        <div class="mt-auto pt-2 border-top">
                            <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm w-100 fw-semibold">
                                Xem chi tiết <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <i class="bi bi-inbox fs-1 text-muted"></i>
            <p class="text-muted mt-2">Hiện chưa có tin tuyển dụng nào phù hợp.</p>
            @if (hasFilter)
            {
                <a asp-action="Index" class="btn btn-outline-primary">Xem tất cả việc làm</a>
            }
        </div>
    }
</div>
