@model InternshipPortal.Web.Models.JobPost

@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Danh sách việc làm</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="badge bg-primary">@Model.Major</span>
                        <span class="badge bg-success">@Model.SalaryRange</span>
                    </div>

                    <h2 class="card-title fw-bold text-dark mb-2">@Model.Title</h2>
                    <h5 class="text-secondary mb-4">@(Model.Company?.CompanyName ?? "Doanh nghiệp")</h5>

                    <hr />

                    <h5 class="fw-bold mt-4 mb-3 text-primary">Mô tả công việc</h5>
                    <p class="text-secondary" style="white-space: pre-line;">@Model.Description</p>

                    <h5 class="fw-bold mt-4 mb-3 text-primary">Yêu cầu ứng viên</h5>
                    <p class="text-secondary" style="white-space: pre-line;">@Model.Requirements</p>

                    <div class="mt-4 pt-3 border-top d-flex gap-2">
                        <a href="javascript:void(0)" class="btn btn-primary px-4" onclick="alert('Tính năng nộp hồ sơ sẽ sẵn sàng ở Ngày tiếp theo!')">
                            Ứng tuyển ngay
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <h6 class="mb-0 fw-bold">Thông tin việc làm</h6>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-3">
                            <span class="text-muted d-block small">Địa điểm làm việc</span>
                            <strong>@Model.Location</strong>
                        </li>
                        <li class="mb-3">
                            <span class="text-muted d-block small">Mức lương trợ cấp</span>
                            <strong>@Model.SalaryRange</strong>
                        </li>
                        <li class="mb-3">
                            <span class="text-muted d-block small">Số lượng tuyển dụng</span>
                            <strong>@Model.Quantity chỉ tiêu</strong>
                        </li>
                        <li class="mb-3">
                            <span class="text-muted d-block small">Hạn nộp hồ sơ</span>
                            <strong class="text-danger">@Model.ExpireDate.ToString("dd/MM/yyyy")</strong>
                        </li>
                        <li>
                            <span class="text-muted d-block small">Trạng thái</span>
                            <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                                @(Model.IsActive ? "Đang mở ứng tuyển" : "Đã đóng")
                            </span>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3">
                    <h6 class="mb-0 fw-bold">Thông tin doanh nghiệp</h6>
                </div>
                <div class="card-body">
                    <h5 class="fw-bold mb-2">@(Model.Company?.CompanyName)</h5>
                    <p class="text-muted small mb-2">
                        <strong>Địa chỉ:</strong> @(Model.Company?.Address ?? "Đang cập nhật")
                    </p>
                    <p class="text-muted small mb-2">
                        <strong>Email liên hệ:</strong> @(Model.Company?.ContactEmail ?? "Đang cập nhật")
                    </p>
                    @if (!string.IsNullOrEmpty(Model.Company?.Website))
                    {
                        <p class="small mb-0">
                            <strong>Website:</strong> <a href="@Model.Company.Website" target="_blank">@Model.Company.Website</a>
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

