@model InternshipPortal.Web.Models.JobPost

@{
    ViewData["Title"] = Model?.Title ?? "Chi tiết tuyển dụng";
}

<div class="row g-4">
    <!-- Cột bên trái: Chi tiết nội dung công việc -->
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm border-0 rounded-3 p-4">
            <h2 class="fw-bold text-dark mb-3">@Model?.Title</h2>
            
            <div class="d-flex flex-wrap gap-2 mb-4">
                <span class="badge bg-primary fs-6">@Model?.Major</span>
                <span class="badge bg-success-subtle text-success border border-success-subtle fs-6">
                    <i class="bi bi-cash-stack me-1"></i>@(string.IsNullOrEmpty(Model?.SalaryRange) ? "Thỏa thuận" : Model.SalaryRange)
                </span>
            </div>

            <div class="mb-4">
                <h5 class="fw-bold border-bottom pb-2 text-primary">
                    <i class="bi bi-file-earmark-text me-2"></i>Mô tả công việc
                </h5>
                <div class="text-secondary lh-base">
                    @Html.Raw(Model?.Description?.Replace("\n", "<br />") ?? "Chưa có thông tin mô tả.")
                </div>
            </div>

            <div class="mb-4">
                <h5 class="fw-bold border-bottom pb-2 text-primary">
                    <i class="bi bi-check2-circle me-2"></i>Yêu cầu ứng viên
                </h5>
                <div class="text-secondary lh-base">
                    @Html.Raw(Model?.Requirements?.Replace("\n", "<br />") ?? "Chưa có thông tin yêu cầu.")
                </div>
            </div>

            <div class="d-lg-none mt-3">
                <button type="button" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#applyModal">
                    <i class="bi bi-send-fill me-2"></i>Ứng tuyển ngay
                </button>
            </div>
        </div>
    </div>

    <!-- Cột bên phải: Thanh thông tin tổng quan (sidebar) -->
    <div class="col-12 col-lg-4">
        <div class="card shadow-sm border-0 rounded-3 p-3 p-md-4">
            <h5 class="fw-bold text-dark mb-3">Thông tin tuyển dụng</h5>
            <ul class="list-unstyled mb-4">
                <li class="mb-3 d-flex align-items-start">
                    <i class="bi bi-building fs-5 text-primary me-2"></i>
                    <div>
                        <small class="text-muted d-block">Công ty</small>
                        <span class="fw-semibold text-break">@(Model?.Company?.CompanyName ?? "Doanh nghiệp đối tác")</span>
                    </div>
                </li>
                <li class="mb-3 d-flex align-items-start">
                    <i class="bi bi-geo-alt fs-5 text-danger me-2"></i>
                    <div>
                        <small class="text-muted d-block">Địa điểm làm việc</small>
                        <span class="fw-semibold text-break">@Model?.Location</span>
                    </div>
                </li>
                <li class="mb-3 d-flex align-items-start">
                    <i class="bi bi-cash fs-5 text-success me-2"></i>
                    <div>
                        <small class="text-muted d-block">Mức lương</small>
                        <span class="fw-semibold">@Model?.SalaryRange</span>
                    </div>
                </li>
                <li class="mb-3 d-flex align-items-start">
                    <i class="bi bi-people fs-5 text-info me-2"></i>
                    <div>
                        <small class="text-muted d-block">Số lượng tuyển</small>
                        <span class="fw-semibold">@(Model?.Quantity ?? 1) chỉ tiêu</span>
                    </div>
                </li>
                <li class="mb-3 d-flex align-items-start">
                    <i class="bi bi-calendar-event fs-5 text-warning me-2"></i>
                    <div>
                        <small class="text-muted d-block">Hạn nộp hồ sơ</small>
                        <span class="fw-semibold">@Model?.ExpireDate.ToString("dd/MM/yyyy")</span>
                    </div>
                </li>
            </ul>

            <button type="button" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#applyModal">
                <i class="bi bi-send-fill me-2"></i>Ứng tuyển ngay
            </button>
        </div>
    </div>
</div>

<!-- Modal Nộp Hồ Sơ Ứng Tuyển -->
<div class="modal fade" id="applyModal" tabindex="-1" aria-labelledby="applyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="applyModalLabel">
                    <i class="bi bi-pencil-square me-2"></i>Nộp Hồ Sơ Ứng Tuyển
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" enctype="multipart/form-data">
                <div class="modal-body p-4">
                    <input type="hidden" name="JobPostId" value="@Model?.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                        <input type="text" name="FullName" class="form-control" placeholder="Nguyễn Văn A" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mã số sinh viên <span class="text-danger">*</span></label>
                        <input type="text" name="StudentId" class="form-control" placeholder="VD: 20210001" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                        <input type="email" name="Email" class="form-control" placeholder="sinhvien@school.edu.vn" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                        <input type="tel" name="PhoneNumber" class="form-control" placeholder="0912345678" required>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-semibold">Đính kèm CV <span class="text-danger">*</span></label>
                        <input type="file" name="CvFile" class="form-control" accept=".pdf" required>
                        <div class="form-text text-muted">Chỉ chấp nhận file định dạng .PDF.</div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary fw-semibold px-4">Xác nhận nộp</button>
                </div>
            </form>
        </div>
    </div>
</div>